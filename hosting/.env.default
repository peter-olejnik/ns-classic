# Server settings, read by compose.yaml. Don't edit this file for your own
# server and never put passwords here: create hosting/.env (gitignored) with
# just the lines you want to change; it overrides this file.

# Game port (UDP). Set it in .env, which compose also reads for the port mapping.
HLDS_PORT=27016
# Launch options for hlds_linux (-game ns and -port are added automatically)
HLDS_OPTS=+maxplayers 32 +map ns_veil +log on -pingboost 3 +sys_ticrate 1000

# Server binary inside ns/ to run instead of dlls/ns.so (built by builder/),
# e.g. a release binary added through overlay/dlls/. Don't use the repo's
# prebuilt dlls/ns_i386.so: it's an old beta build that only lets authorized
# testers join.
NS_GAMEDLL=

# Passwords, passed on the command line at start. Leave empty for none.
RCON_PASSWORD=
# Server join password; HLTV uses it to connect too
SV_PASSWORD=

# HLTV proxy (UDP). Demos are recorded to ns/demos
HLTV_PORT=27020
HLTV_OPTS=+record demos/ns
# Seconds HLTV waits for the server to start
HLTV_DELAY=10

# Log and demo compression (rotate service)
ROTATE_INTERVAL=300
ROTATE_AGE=30
