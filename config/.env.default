# Server settings, read by hosting/compose.yaml. Don't edit this file for your
# own server and never put passwords here: create config/.env (gitignored)
# with just the lines you want to change; it overrides this file. Changes
# apply on the next `compose up -d` without a rebuild (for a port, run
# `hosting/build.sh env` first).

# Game port (UDP), also the host port: compose maps it from hosting/.env,
# which hosting/build.sh writes from this setting.
HLDS_PORT=27016
# Launch options for hlds_linux (-game ns and -port are added automatically)
HLDS_OPTS=+maxplayers 32 +map ns_veil +log on -pingboost 1 +sys_ticrate 333

# Server binary inside ns/ to run instead of dlls/ns.so (built by builder/),
# e.g. a release binary added as config/dlls/<name>.so. Don't use the repo's
# prebuilt dlls/ns_i386.so: it's an old beta build that only lets authorized
# testers join.
NS_GAMEDLL=

# Passwords, passed on the command line at start. Leave empty for none.
RCON_PASSWORD=
# Server join password; HLTV uses it to connect too
SV_PASSWORD=

# HLTV proxy (UDP), optional: podman compose --profile hltv up -d.
# Demos are recorded to ns/demos
HLTV_PORT=27020
HLTV_OPTS=+record demos/ns
# Seconds HLTV waits for the server to start
HLTV_DELAY=10

# Log and demo compression (rotate service)
ROTATE_INTERVAL=300
ROTATE_AGE=30
