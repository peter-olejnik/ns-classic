; AMX Mod X plugins for the ns-classic server: which plugins load.
;
; One plugin per line; a leading ";" disables it. plugins/amxmodx/build.sh
; installs this file as addons/amxmodx/configs/plugins.ini (rebuild, then
; PLUGINS=amxmodx hosting/build.sh). For one server only, put your own copy
; in hosting/overlay/addons/amxmodx/configs/plugins.ini instead.
;
; The stock plugins come with AMX Mod X; the others are compiled from
; plugins/amxmodx/scripting/*.sma (or, with no source, copied from
; plugins/amxmodx/prebuilt/). An enabled plugin that didn't compile is
; commented out in the installed copy with "[not built]" (see
; addons/amxmodx/scripting/ns-classic-compile.txt in the image).
;
; Taken from the old server's plugins.ini (_tmp backup), which also set what's
; on and off below. Plugin settings (cvars) go in configs/amxx.cfg, and some
; plugins read their own files in configs/.
;
; AMX Mod X plugins - NS1

; Admin Base - Always one has to be activated
admin.amxx                      ; admin base (required for any admin-related)
;admin_sql.amxx                 ; admin base - SQL version (comment admin.amxx)

; Basic
admincmd.amxx                   ; basic admin console commands
admincmd2.amxx                  ; advanced admin console commands
adminhelp.amxx                  ; help command for admin console commands
;adminslots.amxx                 ; slot reservation
;multilingual.amxx              ; Multi-Lingual management

; Menus
menufront.amxx                  ; front-end for admin menus
plmenu.amxx                     ; players menu (kick, ban, client cmds.)
cmdmenu.amxx                    ; command menu (speech, settings)
pluginmenu.amxx                 ; Menus for commands/cvars organized by plugin
;telemenu.amxx                  ; teleport menu (Fun Module required!)
mapsmenu.amxx                  ; maps menu (vote, changelevel)

; Chat / Messages
adminchat.amxx                  ; console chat commands
antiflood.amxx                  ; prevent clients from chat-flooding the server
imessage.amxx                   ; displays information messages
adminvote.amxx                  ; vote commands
;scrollmsg.amxx                 ; displays a scrolling message

; Map related
timeleft.amxx                   ; displays time left on map
nextmap.amxx                   ; displays next map in mapcycle
mapchooser.amxx                ; allows to vote for next map

; Configuration
;pausecfg.amxx                   ; allows to pause and unpause some plugins

; NS Specific plugins
;idlekicker.amxx                 ; kicks idle players
nscommands.amxx                 ; extra commands for Natural-Selection
unstuck.amxx                    ; Free stuck players (engine & ns modules required!)
;comstats.amxx                   ; Track Commander win/loss record in nVault
me_gorgerecycle.amxx            ; /rec command for gorges
;CommanderBan.amxx               ; DuoGodOfDeath
;gorge_race_helper.amxx

;-----------------------
; MvM + AvA Related

;ava_enable.amxx                ; Enable Glow.amxx and onilimiter.amxx if you enable this.
mvm_allinone.amxx               ; Enable Glow.amxx and Gllimiter.amxx if you enable this.
glow.amxx                       ; Only used for MvM and AvA
gllimiter.amxx                  ; Limits GL's for MvM CO mode.

;-----------------------
;MISC

amx_pass.amxx                   ; Allow Lts to add password AllTalk TournMode FriendlyFire
const_names.amxx                ; Edit \configs\constant_names.ini for Anti-smurf.
dailyrestart.amxx               ; Restarts the server process when it's empty once per day.
hltv_voices.amxx                ; Ensure all team voices are heard on HLTV 
;icons.amxx                      ; Allows players to have custom icons
;magic_marker.amxx               ; Allows the +paint command to make rainbows (3/15/09 only reservered & in readyroom)
me_helper.amxx                  ; Provide information on various plugins via /help
ocfix.amxx                      ; Changes OC's and turrets so they fire from the top and not the base
ratescheck.amxx                 ; Enables the command rates_list for people with admin_chat level
stacksplit.amxx                 ; Edit \configs\stacksplit.ini to add players.
toggle_random_nvault_4.amxx     ; Running new code from Ag.
upgradestatus.amxx              ; Show the marines what is upgrading.

;-----------------------
;CO Related
combat_buildings.amxx           ; Buildmenu
combatExtender.amxx             ; The vote to extend combat time in the last 5 minutes
combo_limiter_renewed.amxx      ; Limits Onos and GL's to 4 in CO
extralevels3.amxx               ; Allows players to use xmenu
;latejoin.amxx                   ; Limit public access to whichBot if [10] or more slots are taken.
spawninvfun.amxx                ; Enables spawn protection (currently 1.5s)
redemptionkill.amxx             ; Awards XP to marines for alien redemption
XP4Buildings.amxx               ; Gives a small amount of XP for damaging buildings.
hpap.amxx                       ; Shows your killer's hp/armor
hiveccstatus.amxx               ; Display CC and Hive status on the HUD
stickychambers.amxx             ; Sticky Chambers

;kickball.amxx                  ; Kickball is bugged since last valve update. Needs MvM_AllInOne to run.
;bad_combat_extender.amxx       ; Extend time limit at 5 min mark
;wb_control.amxx

;-----------------------
;Siege Related
donateres.amxx                 ; Enables /giveres on siege maps.
defensestack.amxx              ; Allows DC's to stack on Siege maps like 3.1

;-----------------------
; Clan Night Wacko Plugins

;nsmodels1.amxx                 ; Only load new models on Siege maps.
;marinemodelhalloween.amxx      ;Pumpkinhead Marines
;marinemodelxmas.amxx           ;Santa hats on marines
;snipermod.amxx                 ; Converts pistol to AWP in CO
;teamdevour.amxx                ; Allows you to devour teammates to boost health
;ns_rtd.amxx                    ; Roll The Dice
;gnome.amxx                     ; Gnome for NS and CO
;heavyjp.amxx                   ; Heavy Armor can get Jetpacks.  Required Armor 3 for jetpacks.
;me_meal.amxx                   ; Extra Blood and Gibs
;ut_sounds.amxx                 ; Unreal Tournament Sounds

;-----------------------
; Stock AMX Mod X plugins the old plugins.ini didn't list
;statscfg.amxx

