# NS source checkout (cloned from ENSL/NS by builder/build.sh)
src/

# Build output exported by builder/Dockerfile
dist/

# Extra maps and resources to include in mapmerge
ns_maps/
mapmerge/__pycache__/

# Left by `podman machine ssh` from Git Bash (a known_hosts line)
NUL

# Saved choices of ./setup.sh (no secrets)
plan.env

# Local backups (e.g. an old server's addons/, with users.ini and logs)
_tmp/

# config/: only the defaults (*.example, .env.default) and the README are
# committed; every other file there is your own (see config/README.md)
/config/**
!/config/**/
!/config/**/*.example
!/config/.env.default
!/config/README.md
