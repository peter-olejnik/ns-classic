+//
+// Natural Selection Module
+//
+// Linux: the layout of the running ns.so, instead of the NS 3.2 ns_i386.so
+// constants in ns_const.h. Field offsets come from dlls/ns.so.offsets, which
+// the ns-classic builder writes next to the ns.so it compiles (with that
+// ns.so's GNU build ID), and functions are looked up by their symbol.
+// An offset is -1 and a function NULL when it isn't known; the natives
+// that need it then do nothing and return 0.
+//
+
+#ifndef NS_LAYOUT_H
+#define NS_LAYOUT_H
+
+enum NSField
+{
+	NSF_ENTVAR,
+	NSF_RESOURCES,
+	NSF_EXP,
+	NSF_POINTS,
+	NSF_SCORE,
+	NSF_HIVEABILITY,
+	NSF_UPGRADES_BOUGHT,
+	NSF_UPGRADES_ACTIVE,
+	NSF_COMBAT_TECHTREE,
+	NSF_DEATHS,
+	NSF_AMMO_LMG,
+	NSF_AMMO_PISTOL,
+	NSF_AMMO_SHOTGUN,
+	NSF_AMMO_HMG,
+	NSF_AMMO_GL,
+	NSF_AMMO_HG,
+	NSF_PLAYER_ITEMS,
+	NSF_CURRENT_WEAPON,
+	NSF_LAST_WEAPON,
+	NSF_WEAP_NEXT,
+	NSF_WEAPID,
+	NSF_WEAPCLIP,
+	NSF_WEAPRANGE,
+	NSF_WEAPDMG,
+	NSF_STRUCTOWNER,
+	NSF_GHOST_STRUCTURE,
+	NSF_OBS_ENERGY,
+	NSF_HIVE_TRAIT,
+	NSF_WELD_DONE,
+	NSF_WELD_TIME,
+	NSF_GAMEPLAY_TEAMA,
+	NSF_GAMEPLAY_TEAMB,
+	NSF_GAMERULES_TEAMA_RESOURCES,
+	NSF_GAMERULES_TEAMB_RESOURCES,
+	NSF_COUNT
+};
+
+extern int g_NSOffsets[NSF_COUNT];
+
+// Reads the offsets; false (and all offsets -1) if they don't match ns.so
+bool NS_LoadLayout();
+
+// A function of the loaded ns.so by its (mangled) symbol, or NULL
+void *NS_Symbol(const char *name);
+
+#endif // NS_LAYOUT_H
