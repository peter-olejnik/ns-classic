+//     https://alliedmods.net/amxmodx-license
+
+//
+// Natural Selection Module
+//
+
+#if defined(__linux__)
+
+#include "sdk/amxxmodule.h"
+#include "ns_layout.h"
+
+#include <dlfcn.h>
+#include <link.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int g_NSOffsets[NSF_COUNT];
+
+static void *NSHandle = NULL;
+
+// Each field is the sum of the named offsets (as ns.so.offsets lists them)
+// plus a constant
+struct NSFieldSource
+{
+	NSField field;
+	const char *name;
+	const char *plus;
+	int add;
+};
+
+static const NSFieldSource FieldSources[] =
+{
+	{ NSF_RESOURCES,		"AvHPlayer::mResources" },
+	{ NSF_EXP,				"AvHPlayer::mExperience" },
+	{ NSF_POINTS,			"AvHPlayer::mExperienceLevelsSpent" },
+	{ NSF_SCORE,			"AvHPlayer::mScore" },
+	{ NSF_HIVEABILITY,		"AvHPlayer::mNumHives" },
+	{ NSF_UPGRADES_BOUGHT,	"AvHPlayer::mPurchasedCombatUpgrades" },
+	{ NSF_UPGRADES_ACTIVE,	"AvHPlayer::mGiveCombatUpgrades" },
+	{ NSF_COMBAT_TECHTREE,	"AvHPlayer::mCombatNodes" },
+	{ NSF_DEATHS,			"AvHPlayer::m_iDeaths" },
+	// m_rgAmmo slots, in the order NS registers its ammo types
+	{ NSF_AMMO_LMG,			"AvHPlayer::m_rgAmmo", NULL, 2 * 4 },
+	{ NSF_AMMO_PISTOL,		"AvHPlayer::m_rgAmmo", NULL, 3 * 4 },
+	{ NSF_AMMO_SHOTGUN,		"AvHPlayer::m_rgAmmo", NULL, 4 * 4 },
+	{ NSF_AMMO_HMG,			"AvHPlayer::m_rgAmmo", NULL, 5 * 4 },
+	{ NSF_AMMO_GL,			"AvHPlayer::m_rgAmmo", NULL, 6 * 4 },
+	{ NSF_AMMO_HG,			"AvHPlayer::m_rgAmmo", NULL, 7 * 4 },
+	{ NSF_PLAYER_ITEMS,		"AvHPlayer::m_rgpPlayerItems" },
+	{ NSF_CURRENT_WEAPON,	"AvHPlayer::m_pActiveItem" },
+	{ NSF_LAST_WEAPON,		"AvHPlayer::m_pLastItem" },
+	{ NSF_WEAP_NEXT,		"AvHBasePlayerWeapon::m_pNext" },
+	{ NSF_WEAPID,			"AvHBasePlayerWeapon::m_iId" },
+	{ NSF_WEAPCLIP,			"AvHBasePlayerWeapon::m_iClip" },
+	{ NSF_WEAPRANGE,		"AvHBasePlayerWeapon::mRange" },
+	{ NSF_WEAPDMG,			"AvHBasePlayerWeapon::mDamage" },
+	{ NSF_STRUCTOWNER,		"AvHBaseBuildable::mBuilder" },
+	{ NSF_GHOST_STRUCTURE,	"AvHBaseBuildable::mGhost" },
+	{ NSF_OBS_ENERGY,		"AvHMarineBaseBuildable::mEnergy" },
+	{ NSF_HIVE_TRAIT,		"AvHHive::mTechnology" },
+	{ NSF_WELD_DONE,		"AvHWeldable::mTimeBuilt" },
+	{ NSF_WELD_TIME,		"AvHWeldable::mBuildTime" },
+	{ NSF_GAMEPLAY_TEAMA,	"AvHGameplay::mTeamAType" },
+	{ NSF_GAMEPLAY_TEAMB,	"AvHGameplay::mTeamBType" },
+	{ NSF_GAMERULES_TEAMA_RESOURCES,	"AvHGamerules::mTeamA", "AvHTeam::mTeamResources" },
+	{ NSF_GAMERULES_TEAMB_RESOURCES,	"AvHGamerules::mTeamB", "AvHTeam::mTeamResources" },
+};
+
+struct NSEntry
+{
+	char name[96];
+	long value;
+};
+
+static long FindEntry(const NSEntry *entries, int count, const char *name)
+{
+	for (int i = 0; i < count; i++)
+	{
+		if (strcmp(entries[i].name, name) == 0)
+		{
+			return entries[i].value;
+		}
+	}
+	return -1;
+}
+
+struct BuildIdSearch
+{
+	ElfW(Addr) address;	// anything inside the library
+	char hex[2 * 64 + 1];
+};
+
+// dl_iterate_phdr callback: the GNU build ID of the library that holds
+// search->address, from its PT_NOTE segments in memory
+static int FindBuildId(struct dl_phdr_info *info, size_t, void *data)
+{
+	BuildIdSearch *search = reinterpret_cast<BuildIdSearch *>(data);
+	bool found = false;
+
+	for (int i = 0; i < info->dlpi_phnum; i++)
+	{
+		const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+		ElfW(Addr) start = info->dlpi_addr + ph->p_vaddr;
+
+		if (ph->p_type == PT_LOAD && search->address >= start && search->address < start + ph->p_memsz)
+		{
+			found = true;
+		}
+	}
+	if (!found)
+	{
+		return 0;
+	}
+	for (int i = 0; i < info->dlpi_phnum; i++)
+	{
+		const ElfW(Phdr) *ph = &info->dlpi_phdr[i];
+
+		if (ph->p_type != PT_NOTE)
+		{
+			continue;
+		}
+
+		const char *note = reinterpret_cast<const char *>(info->dlpi_addr + ph->p_vaddr);
+		const char *end = note + ph->p_memsz;
+
+		while (note + sizeof(ElfW(Nhdr)) <= end)
+		{
+			const ElfW(Nhdr) *header = reinterpret_cast<const ElfW(Nhdr) *>(note);
+			const char *name = note + sizeof(ElfW(Nhdr));
+			const unsigned char *desc = reinterpret_cast<const unsigned char *>(name + ((header->n_namesz + 3) & ~3));
+
+			if (header->n_type == NT_GNU_BUILD_ID && header->n_namesz == 4 && memcmp(name, "GNU", 4) == 0)
+			{
+				for (unsigned int j = 0; j < header->n_descsz && j < 64; j++)
+				{
+					snprintf(search->hex + 2 * j, 3, "%02x", desc[j]);
+				}
+				return 1;
+			}
+			note = reinterpret_cast<const char *>(desc) + ((header->n_descsz + 3) & ~3);
+		}
+	}
+	return 1;
+}
+
+static bool LoadLayout()
+{
+	char path[256];
+
+	// The game library that metamod loaded (dlls/ns.so, addons/metamod/config.ini)
+	snprintf(path, sizeof(path), "%s/dlls/ns.so", MF_GetModname());
+	NSHandle = dlopen(path, RTLD_NOW | RTLD_NOLOAD);
+
+	if (NSHandle == NULL)
+	{
+		MF_Log("%s isn't loaded (%s)", path, dlerror());
+		return false;
+	}
+
+	BuildIdSearch search;
+	search.address = reinterpret_cast<ElfW(Addr)>(dlsym(NSHandle, "GiveFnptrsToDll"));
+	search.hex[0] = '\0';
+
+	if (search.address == 0 || dl_iterate_phdr(FindBuildId, &search) == 0 || search.hex[0] == '\0')
+	{
+		MF_Log("No GNU build ID in %s", path);
+		return false;
+	}
+
+	snprintf(path, sizeof(path), "%s/dlls/ns.so.offsets", MF_GetModname());
+	FILE *fp = fopen(path, "rt");
+
+	if (fp == NULL)
+	{
+		MF_Log("Can't open %s, which the ns-classic builder writes next to ns.so", path);
+		return false;
+	}
+
+	static NSEntry entries[128];
+	int count = 0;
+	char line[256], key[96], value[160], buildid[160] = "";
+
+	while (fgets(line, sizeof(line), fp) != NULL)
+	{
+		if (sscanf(line, "%95s %159s", key, value) != 2)
+		{
+			continue;
+		}
+		if (strcmp(key, "build_id") == 0)
+		{
+			snprintf(buildid, sizeof(buildid), "%s", value);
+		}
+		else if (count < 128)
+		{
+			snprintf(entries[count].name, sizeof(entries[count].name), "%s", key);
+			entries[count++].value = strtol(value, NULL, 10);
+		}
+	}
+	fclose(fp);
+
+	if (strcmp(buildid, search.hex) != 0)
+	{
+		MF_Log("%s is for ns.so build %s, but the loaded ns.so is build %s", path, buildid[0] ? buildid : "(none)", search.hex);
+		return false;
+	}
+
+	for (size_t i = 0; i < sizeof(FieldSources) / sizeof(FieldSources[0]); i++)
+	{
+		const NSFieldSource *source = &FieldSources[i];
+		long offset = FindEntry(entries, count, source->name);
+		long plus = source->plus ? FindEntry(entries, count, source->plus) : 0;
+
+		if (offset < 0 || plus < 0)
+		{
+			MF_Log("%s lacks %s", path, offset < 0 ? source->name : source->plus);
+			return false;
+		}
+		g_NSOffsets[source->field] = static_cast<int>(offset + plus + source->add);
+	}
+	for (int i = 0; i < NSF_COUNT; i++)
+	{
+		if (g_NSOffsets[i] < 0)
+		{
+			MF_Log("ns_layout.cpp has no source for field %d", i);
+			return false;
+		}
+	}
+
+	MF_Log("Using the field offsets in %s (ns.so build %s)", path, buildid);
+	return true;
+}
+
+bool NS_LoadLayout()
+{
+	for (int i = 0; i < NSF_COUNT; i++)
+	{
+		g_NSOffsets[i] = -1;
+	}
+
+	// CBaseEntity::pev, right after the vtable pointer
+	g_NSOffsets[NSF_ENTVAR] = 4;
+
+	if (LoadLayout())
+	{
+		return true;
+	}
+
+	for (int i = 0; i < NSF_COUNT; i++)
+	{
+		if (i != NSF_ENTVAR)
+		{
+			g_NSOffsets[i] = -1;
+		}
+	}
+
+	MF_Log("The natives that use NS memory are disabled (they return 0)");
+	return false;
+}
+
+void *NS_Symbol(const char *name)
+{
+	void *address = NSHandle ? dlsym(NSHandle, name) : NULL;
+
+	if (address == NULL)
+	{
+		MF_Log("Can't find %s in ns.so; the natives that call it are disabled", name);
+	}
+	return address;
+}
+
+#endif // __linux__
