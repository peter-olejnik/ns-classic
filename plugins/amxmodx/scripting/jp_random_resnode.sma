#define PLUGIN	"Random ResNodes"
#define AUTHOR	"JPiolho"
#define VERSION	"1.0"

new g_random_resnode_status

public plugin_init()
{
	register_plugin(PLUGIN, VERSION, AUTHOR)
	register_concmd("random_resnodes","restart",ADMIN_SLAY," Restart map with random Resnodes plugin enabled.")	
}

public restart( id, level, cid )
{
	if ( !cmd_access(id, level, cid, 1) )
		return PLUGIN_HANDLED
	
	if(ns_is_combat())
	{
		console_print (id, "Command only works on NS maps" )
		return PLUGIN_HANDLED
	}
	
	new mapname[64]
	get_mapname(mapname,63)
	set_localinfo("random_resnode_status","1")
	server_cmd("changelevel %s", mapname)
	return PLUGIN_HANDLED
}

public plugin_precache()
{
	new sInfo[8]
	get_localinfo("random_resnode_status", sInfo, 7)
	g_random_resnode_status = str_to_num(sInfo)
	
	precache_model("models/b_resource_nozzle.mdl")

}

