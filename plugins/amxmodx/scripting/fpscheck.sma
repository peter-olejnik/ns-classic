/* Plugin generated by AMXX-Studio */

#include <amxmodx>
#include <amxmisc>

#define PLUGIN "fpscheck"
#define VERSION "1.0"
#define AUTHOR "Garterman"


public plugin_init() {
register_plugin("fpscheck", AMXX_VERSION_STR, "Garterman")
register_clcmd("fpsforce", "cmdFps", ADMIN_KICK, "- Kick for high fps_max (1=on,0=off)")
register_cvar("fps_force","1",FCVAR_EXTDLL|FCVAR_SPONLY|FCVAR_ARCHIVE)
}

public client_connect(id) {
new params[1]
params[0] = id
new Float:delay
delay = random_float(30.0,60.0)
set_task(delay,"doFpsCheck",id, params, 1, "b")
return PLUGIN_HANDLED
}

public doFpsCheck(id,pid) {
// client_print(pid,print_chat,"Checked you!")
query_client_cvar(pid,"fps_max","checkfpsresult")
query_client_cvar(pid,"fps_modem","checkfpsresult")
}

public checkfpsresult(id, const cvar[], const valuestr[]) {
new name[32]
get_user_name(id, name, 31)
new fps = str_to_num(valuestr)
if (fps > 125) {
log_amx("Player '%s' found with fps_max %d",name,fps)
if (get_cvar_num("fps_force") == 1) {
client_print(0, print_chat, "Player '%s' found with fps_max %d",name,fps)
server_cmd("kick #%d ^"Sorry, fps_max above 125 is not allowed^"", get_user_userid(id), id)
}
}
}

public cmdFps(id, level, cid) {
if (!cmd_access(id, level, cid, 2))
return PLUGIN_HANDLED
new param[2]
read_argv(1, param, 1)
new enabled = str_to_num(param)
if (enabled == 2 )
client_print(id, print_center, "Kicking for fps_max: %d",get_cvar_num("fps_force"))

if (enabled == 0) {
set_cvar_num ("fps_force",0)
client_print(0, print_center, "Kicking for high fps_max off")
}
if (enabled == 1) {
set_cvar_num ("fps_force",1)
client_print(0, print_center, "Kicking for high fps_max on")
}
return PLUGIN_HANDLED
}
