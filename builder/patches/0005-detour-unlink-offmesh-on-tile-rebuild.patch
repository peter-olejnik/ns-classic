+// Removing a tile drops the links of off-mesh connections that start or end in
+// it; mark them dirty so update() links them to the rebuilt tile again.
+static void markOffMeshConnectionsDirty(dtOffMeshConnection* cons, const int count, const int tx, const int ty, const int tlayer)
+{
+	for (int i = 0; i < count; ++i)
+	{
+		dtOffMeshConnection* con = &cons[i];
+		if (con->state != DT_OFFMESH_CLEAN)
+			continue;
+		if ((con->FromTileX == tx && con->FromTileY == ty && con->FromTileLayer == tlayer) ||
+			(con->ToTileX == tx && con->ToTileY == ty && con->ToTileLayer == tlayer))
+			con->state = DT_OFFMESH_DIRTY;
+	}
+}
